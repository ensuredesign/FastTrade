# Copy to .env for local overrides. Never commit real credentials.

# Nebius Token Factory Configuration (NVIDIA Nemotron Model-Tier Routing + Sandboxes Beta)
NEBIUS_API_KEY=your_nebius_token_factory_api_key_here
NEBIUS_PROJECT_ID=aiproject-your_project_id_here
NEBIUS_SA_ID=serviceaccount-your_sa_id_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# NVIDIA Nemotron 3 Model Tiers on Nebius Token Factory
NEBIUS_MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_MODEL_BALANCED=nvidia/nemotron-3-super-120b-a12b
NEBIUS_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# Tavily Financial Intelligence Configuration
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# LangSmith Agentic Observability & Run-Tree Tracing
LANGSMITH_API_KEY=lsv2_pt_your_langsmith_api_key_here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=FastTrade-Nebius-EMS

# Resend Transactional Email Configuration
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL="FastTrade <info@ensure.in>"

# Self-Hosted Supabase Configuration
SUPABASE_URL=https://fasttrade-sb.propixer.in
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_DB_USER=your_studio_or_db_user
SUPABASE_DB_PASSWORD=your_studio_or_db_password

# Set true only when a live NVIDIA/Nebius inference endpoint is available.
FASTTRADE_FORECAST_ENABLED=false
FASTTRADE_FORECAST_ENDPOINT=
FASTTRADE_FORECAST_TIMEOUT=2.0
FASTTRADE_FORECAST_MAX_STALENESS=5.0

# Optional. Only required if the deployed model server enables authentication.
FASTTRADE_FORECAST_API_KEY=

# Optional override for the forecast server artifact path.
FASTTRADE_FORECAST_ARTIFACT=models/saved/directional_forecaster.pt
